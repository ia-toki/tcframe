#!/usr/bin/env bash
# Thin shim: every command is implemented by the Python CLI in cli/.
# TCFRAME_HOME defaults to this checkout when not set.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

export TCFRAME_HOME="${TCFRAME_HOME:-$REPO_ROOT}"
export PYTHONPATH="$REPO_ROOT/cli${PYTHONPATH:+:$PYTHONPATH}"

exec "${TCFRAME_PYTHON:-python3}" -m tcframe_cli "$@"
